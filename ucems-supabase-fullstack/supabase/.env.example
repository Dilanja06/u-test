# Only configure inside Supabase Dashboard > Edge Functions > Secrets, or with supabase secrets set.
# Do not put any of these into web/.env or mobile/.env.
STRIPE_TEST_SECRET_KEY=sk_test_YOUR_STRIPE_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_TEST_WEBHOOK_SECRET
APP_URL=http://localhost:5173
# Supabase normally provides SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY to functions.
